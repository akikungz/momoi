# Core
# Example: development
NODE_ENV=
# Example: 3000
PORT=

# Security
# Example: changeme_change_to_a_32_char_secret
JWT_SECRET=

# Database
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Cache
# Example: redis://:PASSWORD@HOST:6379
REDIS_URL=

# Auth
# Example: http://localhost:3000
BETTER_AUTH_URL=

# Storage provider
# Example: database | s3
STORAGE_PROVIDER=

# S3-compatible storage (MinIO, Cloudflare R2, Ceph, etc.)
# Example: http://localhost:9000
S3_ENDPOINT=
# Example: minioadmin
S3_ACCESS_KEY_ID=
# Example: minioadmin
S3_SECRET_ACCESS_KEY=
# Example: us-east-1
S3_REGION=
# Example: momoi-storage
S3_BUCKET_NAME=
# Example: true
S3_FORCE_PATH_STYLE=
# Example: 900
S3_PRESIGN_EXPIRES_SECONDS=

# Telemetry
# Example: momoi
OTEL_SERVICE_NAME=
# Example: http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# Example: grpc | http
OTEL_EXPORTER_OTLP_PROTOCOL=
# Example: otel
OTEL_EXPORTER_OTLP_USERNAME=
# Example: otel-secret
OTEL_EXPORTER_OTLP_PASSWORD=
# Example: true
OTEL_FAIL_OPEN=
# Example: 10000
OTEL_METRIC_EXPORT_INTERVAL=
# Example: 5000
OTEL_METRIC_EXPORT_TIMEOUT=
# Example: info
LOG_LEVEL=
# Example: json
LOG_FORMAT=
# Example: false
LOG_PRETTY=

# Monitoring
# Example: http://localhost:9090
PROMETHEUS_BASE_URL=
# Example: 10000
PROMETHEUS_TIMEOUT_MS=
# Example: your-prometheus-token
PROMETHEUS_BEARER_TOKEN=
# Example: prometheus-user
PROMETHEUS_USERNAME=
# Example: prometheus-password
PROMETHEUS_PASSWORD=
